# LINE Messaging API
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# LLM provider: "gemini" (default) or "claude"
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Anthropic (LLM_PROVIDER=claude の場合のみ必要)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database (Neon — pooled endpoint 推奨)
# Neon の接続文字列の postgres:// を postgresql+asyncpg:// に置き換えて使う
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# App
SUMMARY_MESSAGE_LIMIT=200
